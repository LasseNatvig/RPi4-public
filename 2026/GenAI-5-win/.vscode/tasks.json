{
    "version": "2.0.0",
    "windows": {
        "command": "nmake",
        "options": {
            "env": {
                "Path": "${env:Path};${env:VCINSTALLDIR}Tools/Llvm/bin"
            }
        }
    },
    "tasks": [
        {
            "type": "shell",
            "label": "Build Debug Executable",
            "windows": {
                "args": [
                    "\"DEBUG_BUILD=true\"",
                    "debug.exe"
                ]
            },
            "problemMatcher": "$msCompile",
            "group": "build",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared",
                "showReuseMessage": true,
                "clear": true
            }
        },
        {
            "type": "shell",
            "label": "Build Release Executable",
            "windows": {
                "args": [
                    "release.exe"
                ]
            },
            "problemMatcher": "$msCompile",
            "group": "build",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared",
                "showReuseMessage": true,
                "clear": true
            }
        },
        {
            "type": "shell",
            "label": "Build and Run Release",
            "windows": {
                "command": "nmake release.exe && release.exe"
            },
            "group": "build",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": true,
                "panel": "shared",
                "showReuseMessage": true,
                "clear": true
            }
        }
    ]
}